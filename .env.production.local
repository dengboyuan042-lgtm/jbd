# Runtime config for the hosted instance of this workspace.
AUTH_SECRET="rotate-this-in-your-own-deployment-3f9c2a71b48e5d06"

# Served inside a cross-origin iframe, so the session cookie must be
# SameSite=None (which forces Secure). Use "lax" on your own domain.
COOKIE_SAMESITE=none

# Private instance: no public sign-up. Provision accounts with
#   npm run account:create -- <email> "<name>" <password>
ALLOW_SIGNUP=false

DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=./.data/pglite
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
AI_DRIVER=local
EMBEDDING_DRIVER=local
EMBEDDING_DIMENSIONS=768
SPEECH_DRIVER=local
