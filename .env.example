# ── Core ────────────────────────────────────────────────────────────────────
APP_NAME="AskSia Pro"
AUTH_SECRET="change-me-to-a-long-random-string"
NODE_ENV="development"

# ── Database ────────────────────────────────────────────────────────────────
# driver: "pglite" (embedded Postgres, zero-config dev) | "postgres" (real server)
DATABASE_DRIVER="pglite"
# Used when DATABASE_DRIVER=postgres. Requires the `vector` extension.
DATABASE_URL="postgresql://user:pass@localhost:5432/workspace"
# Used when DATABASE_DRIVER=pglite
PGLITE_DATA_DIR="./.data/pglite"

# ── Storage ─────────────────────────────────────────────────────────────────
# driver: "local" | "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.data/storage"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── AI provider ─────────────────────────────────────────────────────────────
# driver: "openai" | "anthropic" | "google" | "openai-compatible" | "local"
# "local" is a dependency-free deterministic provider used so the product runs
# end-to-end without API keys. Swap the env vars to go live.
AI_DRIVER="local"
AI_CHAT_MODEL=""
AI_EMBEDDING_MODEL=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
GOOGLE_API_KEY=""
GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# ── Embeddings ──────────────────────────────────────────────────────────────
# driver: "provider" (use AI_DRIVER) | "local" (deterministic hashing embedder)
EMBEDDING_DRIVER="local"
EMBEDDING_DIMENSIONS="768"

# ── Speech / ASR provider ───────────────────────────────────────────────────
# driver: "openai-whisper" | "deepgram" | "browser" | "local"
SPEECH_DRIVER="local"
DEEPGRAM_API_KEY=""
